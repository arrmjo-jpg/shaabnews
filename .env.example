APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# عناوين الواجهات الأمامية المنفصلة (تُستخدم في روابط البريد مثل إعادة تعيين كلمة المرور)
# محلياً: القيم أدناه. الإنتاج (Coolify env vars، لا تُقرأ من هذا الملف):
#   APP_URL=https://api.harer.store  |  FRONTEND_URL=https://harer.store  |  ADMIN_FRONTEND_URL=https://admin.harer.store
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alphacms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=alphacms

# نطاقات توصيل الأصول والوسائط (CDN / R2) — راجع config/cdn.php
CDN_ENABLED=false
CDN_URL="${APP_URL}"
MEDIA_URL="${APP_URL}"

# أصل روابط الوسائط العامّة (القرص public: /storage — شعارات/أيقونات/فافيكون/صور الكُتّاب…). يُخدَم /storage
# مباشرةً من خادم الويب (Traefik/Nginx → Laravel public/storage) على **الأصل العامّ** — لا عبر Next.js.
#  • محليًّا: ${APP_URL} (الباك-إند يخدم /storage على نفس أصل التطبيق).
#  • الإنتاج: **اتركه فارغًا ⇒ يُستعمَل FRONTEND_URL** (الأصل العامّ؛ Traefik يوجّه دومين الموقع/storage
#    للباك-إند — راجع docker-compose.yml). **لا تضبطه على دومين الـAPI (api.*)**. (مختلف عن MEDIA_URL = R2.)
MEDIA_PUBLIC_URL="${APP_URL}"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────
# تقوية الإنتاج (Waves 1–3) — اضبط هذه القيم قبل النشر
# ─────────────────────────────────────────────────────────────────────

# CORS — أصول الواجهة الإدارية فقط (لا تستخدم * أبداً)
CORS_ALLOWED_ORIGINS=https://admin.harer.store

# نطاقات Sanctum الحالة (stateful) — تُقرأ اختيارياً بواسطة config/sanctum.php؛ الافتراضي الحالي
# (localhost variants) يكفي محلياً. في الإنتاج اضبطها على نطاقات الواجهات الفعلية:
# SANCTUM_STATEFUL_DOMAINS=admin.harer.store,harer.store

# انتهاء صلاحية توكن Sanctum بالدقائق (افتراضي 7 أيام)
SANCTUM_TOKEN_EXPIRATION=10080

# مهلة SMTP بالثواني (يمنع تعلّق الطلب على البريد)
MAIL_TIMEOUT=10

# ─── النسخ الاحتياطي (إلزامي في الإنتاج) ─────────────────────────────
# أقراص الوجهة — أوفسايت إلزامي: s3 أو "local,s3"
BACKUP_DESTINATION_DISKS=local
# كلمة مرور تشفير الأرشيف (سرّ — مدير أسرار)
BACKUP_ARCHIVE_PASSWORD=
# التحقق من سلامة الأرشيف بعد الإنشاء
BACKUP_VERIFY=true
# وجهة تنبيهات النسخ (بريد عمليات حقيقي)
BACKUP_NOTIFICATION_EMAIL=

# ─── مراقبة الصحّة ───────────────────────────────────────────────────
HEALTH_NOTIFICATION_EMAIL=
# توكن سرّي اختياري لمسار نتائج الصحّة (طبقة دفاع إضافية)
HEALTH_SECRET_TOKEN=

# ─── إبطال كاش الواجهة (Next ISR webhook) — إلزامي إنتاجاً ────────────
# يُخطِر واجهة Next بإبطال الوسوم عند نشر/تعديل المحتوى (config/services.php).
# يجب أن يطابق FRONTEND_REVALIDATE_SECRET قيمة REVALIDATE_SECRET في الواجهة.
FRONTEND_REVALIDATE_URL=https://harer.store/api/revalidate
FRONTEND_REVALIDATE_SECRET=
FRONTEND_REVALIDATE_TIMEOUT=5

# ─── إخطار محركات البحث (legacy sitemap ping) — اختياري، مُعطَّل افتراضياً ──
# يُخطِر Google + Bing بتحديث الخريطة عند النشر. ⚠️ النقطتان مُهملتان فعلياً (قد تُرجِعان 404).
SEARCH_PING_ENABLED=false

# ─── البحث (Scout / Meilisearch) ────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# مفتاح Meilisearch — يُقرأ من هنا بواسطة config/scout.php وdocker-compose.yml (${MEILISEARCH_KEY})
# وحاوية meilisearch نفسها (MEILI_MASTER_KEY). لا تتركه فارغاً — يجب ألا يقل عن 16 بايت، وإلا
# سترفض حاوية meilisearch الإقلاع بخطأ "master key must be at least 16 bytes". ولّد قيمة إنتاجية
# حقيقية عبر: openssl rand -hex 32 — واحفظها كسرّ في منصّة النشر، لا في هذا الملف.
MEILISEARCH_KEY=

# ─── أدوات الوسائط ───────────────────────────────────────────────────
# محرّك معالجة الصور (gd افتراضي؛ imagick بديل). ثنائيّات ffmpeg في PATH داخل الصورة.
IMAGE_DRIVER=gd
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ─── أسرار النشر (docker-compose) — ليست من قراءة Laravel بل تفعيل compose ──
# DB_ROOT_PASSWORD=        # كلمة مرور جذر MySQL (حاوية قاعدة البيانات)
# CLIENT=shaabjo           # العميل المُجمَّع في صورة الواجهة

# ─── legacy-db (docker-compose.override.yml, dev only) — استيراد database/shaab.sql المعزول ──
# حاوية MySQL منفصلة تماماً عن قاعدة بيانات التطبيق (DB_* أعلاه) - تُستخدَم فقط لاستضافة نسخة
# shaab.sql القديمة (تصدير WordPress خام، ~79 ألف مقال) للفحص/الترحيل. قيمة تطويرية محلية بحتة،
# لا تُستخدَم في الإنتاج ولا يقرأها Laravel إطلاقاً.
LEGACY_DB_ROOT_PASSWORD=change_me_local_dev_only
# LEGACY_DB_NAME=shaab_legacy   # اسم القاعدة داخل الحاوية (افتراضي: shaab_legacy)
# LEGACY_DB_PORT=3307          # منفذ المضيف (افتراضي: 3307 - متعمَّد كي لا يصطدم بـ MySQL المحلي على 3306)
#
# API_BASE_URL / SITE_URL / REVALIDATE_SECRET — بيئة حاوية frontend (Next.js).
# REVALIDATE_SECRET يجب أن يطابق FRONTEND_REVALIDATE_SECRET أعلاه بالضبط.
#
# API_BASE_URL و BUILD_API_BASE_URL أدناه **نفس القيمة دائمًا** منذ الانقسام المعماريّ
# (shaabnews-backend/workers/frontend/admin كـCoolify Applications مستقلة — انظر
# docs/architecture أو DEPLOYMENT.md): بعد أن أصبح backend Application مستقلاً بذاته، دائم
# التشغيل، لا يعتمد على وجود frontend حيّ، أصبح الاعتماد الوحيد المتبقّي هو "يجب أن يكون backend
# صحيًّا **قبل بدء نشر frontend**" — وهذه مشكلة **ترتيب نشر** (يحلّها
# .github/workflows/deploy.yml)، لا مشكلة شبكة Docker معزولة كما كانت. القيمة العامة (Traefik)
# تعمل identically وقت البناء ووقت التشغيل، محليًّا وفي CI وفي الإنتاج — بلا استثناءات، بلا
# host.docker.internal، بلا نشر منفذ backend على المضيف.
#
# ⚠️ تاريخيًّا (قبل الانقسام، commit 0773979، عطل 2026-08-07/08): كانت القيمة العامة مرفوضة صراحةً
# هنا لأن backend وfrontend كانا Coolify Application واحدًا، فبناء frontend الفاشل كان يمنع حتى
# backend من العمل. لم يعد هذا صحيحًا بعد الفصل — راجع DEPLOYMENT.md قبل تغيير هذا القرار مجددًا.
API_BASE_URL=https://api.harer.store
BUILD_API_BASE_URL=https://api.harer.store
SITE_URL=https://harer.store
REVALIDATE_SECRET=

# ⚠️ ملغى (Phase F، 2026-08-09): BACKEND_DOMAIN/FRONTEND_DOMAIN/ADMIN_DOMAIN لم تعد مستخدَمة.
# جُرِّبت كمتغيّرات ${...} داخل Traefik labels في docker-compose.{backend,frontend,admin}.yml،
# لكن Coolify لا يُفسِّر متغيّرات البيئة داخل قسم labels: إطلاقًا (مؤكَّد حيًّا: docker exec ...env
# أظهر المتغيّر محقونًا بشكل صحيح داخل بيئة الحاوية، لكن docker inspect لنفس الحاوية أظهر النص
# الحرفي غير المُفسَّر ${BACKEND_DOMAIN:?...} في الـlabel الفعليّ — Coolify يمرّر labels: كنصّ خام).
# الدومينات الآن قيم حرفية مباشرة داخل كل ملف compose (يطابق نمط docker-compose.yml الموحَّد
# القديم المُثبَت العمل). الانتقال للدومين الحقيقيّ عند cutover = تعديل الملفات + commit + push،
# لا متغيّر بيئة.

# مفاتيح تصل البناءَ عبر BuildKit secrets (لا build args ⇒ لا أثر في طبقات الصورة)،
# وتصل وقتَ التشغيل عبر environment: كالمعتاد.
# OPENWEATHER_API_KEY مطلوب: /weather ضمن قائمة الصفحات الحرجة في بوّابة التحقّق بعد البناء.
OPENWEATHER_API_KEY=
# اختياريّ — يُرسَل كترويسة X-Internal-Token إن ضُبط (config/services.php + lib/env.ts).
INTERNAL_API_TOKEN=

# ─── WP migration: media source ──────────────────────────────────────────────────────────────
# THE single setting that decides where migrated images come from. Set it to the live WordPress
# site's public origin and every attachment is downloaded straight from it:
#     <WP_BASE_URL>/wp-content/uploads/2024/05/image.jpg
# No local wp-content/uploads copy, no directory mounted or copied into the container, and no
# domain hardcoded anywhere - changing the source site means changing this line only.
# Downloads reuse the existing SSRF-safe fetch path (HTTPS-only, redirect cap, connect/read
# timeouts, retries, size + Content-Type + content-sniffed MIME validation), the existing
# checksum dedupe, and the existing queued conversion pipeline.
# Leave empty to keep the previous behaviour exactly: resolve from the run's local uploads_path.
WP_BASE_URL=https://example.com

# Fetch tuning (seconds). connect = establishing the connection, timeout = the whole transfer.
# WP_MIGRATION_FETCH_CONNECT_TIMEOUT=5
# WP_MIGRATION_FETCH_TIMEOUT=10
# WP_MIGRATION_FETCH_RETRIES=2

# ─── WP migration: controlled remote media fallback (LOCAL MODE ONLY) ────────────────────────
# Ignored when WP_BASE_URL is set (remote is then the primary source, so there is nothing to
# fall back from). Only meaningful in local mode: when no file is found under uploads_path,
# fall back to the same SSRF-safe fetch instead of leaving the reference unresolved.
# WP_MIGRATION_ALLOW_REMOTE_FALLBACK=false
